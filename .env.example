# Copy to .env and fill in real values. Never commit .env.
# This single file is read by both Docker Compose (database container) and
# Django (application settings).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (shared by Docker Compose and Django) ---
POSTGRES_DB=elm_dev
POSTGRES_USER=elm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
# Port Django connects to on the host; must match POSTGRES_HOST_PORT below.
POSTGRES_PORT=5433
# Host port the database container is published on.
POSTGRES_HOST_PORT=5433
