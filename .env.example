# Copy to .env and fill in real values. Never commit .env.
# This single file is read by both Docker Compose (database container) and
# Django (application settings).

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# --- Sessions, CSRF and login (defaults shown; all optional) ---
# Frontend origins allowed to send POSTs (login/logout) with a CSRF token.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set both to true in any HTTPS deployment.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Session lifetime in seconds (8 hours). Without "Remember me" the session also
# ends when the browser is closed.
SESSION_COOKIE_AGE=28800
# Session lifetime when "Remember me" is ticked (30 days).
REMEMBER_ME_SESSION_AGE=2592000
LOGIN_THROTTLE_RATE=20/minute

# --- Forgot password (defaults shown; all optional) ---
# How long an emailed code stays valid, in seconds (10 minutes).
PASSWORD_RESET_CODE_TTL=600
# Wrong guesses allowed per code before it stops working.
PASSWORD_RESET_MAX_ATTEMPTS=5
# Minimum seconds between two codes for the same account.
PASSWORD_RESET_RESEND_COOLDOWN=60
PASSWORD_RESET_THROTTLE_RATE=20/hour

# --- Email (optional) ---
# Leave SMTP_HOST empty to print emails to the runserver console instead.
DEFAULT_FROM_EMAIL=Employee Leave Management <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Put the real SMTP password only in .env, never in .env.example.
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Number of trusted reverse proxies in front of Django. Keep 0 locally so the
# client-supplied X-Forwarded-For header is ignored; behind a reverse proxy set
# it to the number of proxies (e.g. 1) so the login throttle sees the real IP.
DRF_NUM_PROXIES=0

# --- Initial administrator (used by `manage.py create_admin`) ---
ELM_ADMIN_USERNAME=
ELM_ADMIN_EMAIL=
# Never store ELM_ADMIN_PASSWORD in .env: Django loads .env into every process,
# so the password would stay on disk and in the environment. Export it in the
# shell for a single create_admin run instead (see README).

# --- Database (shared by Docker Compose and Django) ---
POSTGRES_DB=elm_dev
POSTGRES_USER=elm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
# Port Django connects to on the host; must match POSTGRES_HOST_PORT below.
POSTGRES_PORT=5433
# Host port the database container is published on.
POSTGRES_HOST_PORT=5433
